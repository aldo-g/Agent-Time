OPENAI_API_KEY=sk-your-openai-key
CLAUDE_API_KEY=your-claude-api-key
GEMINI_API_KEY=your-gemini-api-key
MANIFOLD_API_KEY_OPENAI=your-manifold-key-for-agentchatgpt-wallet
MANIFOLD_API_KEY_CLAUDE=your-manifold-key-for-agentclaude-wallet
MANIFOLD_API_KEY_GEMINI=your-manifold-key-for-agentgemini-wallet
# Optional generic key for local one-off scripts that read MANIFOLD_API_KEY directly.
MANIFOLD_API_KEY=your-manifold-api-key
# Optional overrides for Manifold API access.
MANIFOLD_API_ROOT=https://api.manifold.markets/v0
MANIFOLD_BETS_LIMIT=500
AGENT_MARKET_CACHE_LIMIT=10
AGENT_WALLET_RETRY_LIMIT=5
# In Docker Compose this should remain enabled so container runtime uses only compose-injected env.
AGENT_DISABLE_DOTENV=1
DATABASE_URL=postgresql://agent_time:your-password@postgres:5432/agent_time
