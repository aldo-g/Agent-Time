aws_region                 = "eu-west-1"
environment                = "prod"
default_instance_type      = "t3.micro"
create_public_eips         = true
enable_timers              = true
run_service_once_on_boot   = true
default_schedule           = "*-*-* 12:00:00 UTC"
enable_shared_market_cache = false
create_market_fetcher_instance = false
bot_skip_market_fetch      = false

enable_dashboard_service   = true
dashboard_port             = 3000
dashboard_host             = "0.0.0.0"
dashboard_bind_address     = "0.0.0.0"
dashboard_ingress_cidr     = null

enable_dashboard_alb       = true
dashboard_alb_ingress_cidr = "0.0.0.0/0"
dashboard_target_bot_key   = "gpt"

# REQUIRED: replace with your public DNS name and zone.
dashboard_domain_name      = "agent.yourdomain.com"

# Use one of these:
# dashboard_route53_zone_id   = "Z1234567890ABC"
dashboard_hosted_zone_name = "yourdomain.com"

# Optional: if you already have an ACM certificate in this region, set it and
# Terraform will skip certificate creation/validation.
# dashboard_certificate_arn = "arn:aws:acm:eu-west-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

create_dashboard_dns_record = true
dashboard_ssl_policy        = "ELBSecurityPolicy-2016-08"

# Optional DB wiring:
# database_url_param_name = "/agent-time/prod/DATABASE_URL"
# require_database_url    = true
