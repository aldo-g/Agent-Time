aws_region             = "us-east-1"
environment            = "dev"
default_instance_type  = "t3.micro"
create_public_eips     = false
enable_timers          = true
run_service_once_on_boot = true
default_schedule       = "hourly"
enable_shared_market_cache = true
create_market_fetcher_instance = true
market_fetcher_instance_type = "t3.micro"
market_fetcher_schedule = "hourly"
market_cache_wait_seconds = 180
market_cache_max_age_seconds = 7200
# shared_market_cache_object_key = "shared/shared_markets.json"
# shared_market_cache_force_destroy = false
# Optional: shared Supabase/Postgres connection for all bots.
# database_url_param_name = "/agent-time/dev/DATABASE_URL"
# require_database_url = true

# Optional: allow SSH from your IP. Leave null to use SSM Session Manager only.
# ssh_ingress_cidr = "1.2.3.4/32"

